# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=dgmc_dietary_secret_jwt_key_9501

# MySQL Database (Optional - fallback to SQLite WAL / JSON mirror in local dev)
# For container-to-container in Docker network: use 'dgmc_mysql' or 'db'
# For containerized app connecting to host-mapped MySQL: use 'host.docker.internal' (avoids 127.0.0.1 container loopback)
# For standalone local Node runtime: use '127.0.0.1' or 'localhost'
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=dgmc_user
MYSQL_PASSWORD=dgmc_password
MYSQL_DATABASE=dgmc_meals

# Redis Cache (Optional - fallback to memory cache)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FAMILY=4
REDIS_CONNECT_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_KEEP_ALIVE=10000
REDIS_ENABLE_OFFLINE_QUEUE=true

# AI Features (Optional)
GEMINI_API_KEY=
